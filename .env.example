# Application URL - Update this to match your deployment URL
REACT_APP_URL=http://localhost:3000

# Spotify API Configuration
# Get your Client ID from: https://developer.spotify.com/dashboard
# Make sure to set the Redirect URI in your Spotify app to: {REACT_APP_URL}/auth
REACT_APP_SPOTIFY_CLIENT_ID=

# Error Tracking (Optional)
# Get your DSN from: https://sentry.io/
REACT_APP_SENTRY_DSN=

# Development Configuration (Optional)
# Uncomment and set these for development customization

# Browser to open during development (set to 'none' to disable auto-open)
# BROWSER=none

# Port for development server
# PORT=3000

# Enable/disable source maps in production
# GENERATE_SOURCEMAP=false

# Bundle analyzer (set to 'true' to analyze bundle size)
# ANALYZE=false