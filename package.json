{
  "name": "spotify-release-list",
  "author": "Jakub Dobes <dobes.jakub@gmail.com>",
  "version": "3.2.0",
  "private": true,
  "repository": "github:jakubito/spotify-release-list",
  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/browser": "^8.38.0",
    "ajv": "^8.20.0",
    "bulma": "^0.9.4",
    "bulma-checkradio": "^2.1.3",
    "classnames": "^2.5.1",
    "colord": "^2.9.3",
    "fast_array_intersect": "^1.1.0",
    "fuse.js": "^7.4.2",
    "js-base64": "^3.7.8",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "pretty-bytes": "^7.1.0",
    "query-string": "^9.4.0",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dates": "^21.8.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-intersection-observer": "^10.0.3",
    "react-ios-pwa-prompt": "^2.0.6",
    "react-redux": "^9.3.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.17.0",
    "react-scripts": "^5.0.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.5.0",
    "reselect": "^5.2.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@opengovsg/credits-generator": "^1.0.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "serve": "^14.2.6",
    "source-map-explorer": "^2.5.3"
  },
  "scripts": {
    "start": "REACT_APP_GIT_SHA=`git rev-parse --short HEAD` REACT_APP_VERSION=$npm_package_version BROWSER=none react-scripts start",
    "build": "REACT_APP_GIT_SHA=`git rev-parse --short HEAD` REACT_APP_VERSION=$npm_package_version react-scripts build",
    "preview": "serve -s build",
    "test": "react-scripts test --testPathIgnorePatterns=fixtures",
    "eject": "react-scripts eject",
    "prettify": "prettier --write 'src/**/*.{js,scss}'",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "credits": "credits-generator"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "*.js"
        ],
        "rules": {
          "react-hooks/exhaustive-deps": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
